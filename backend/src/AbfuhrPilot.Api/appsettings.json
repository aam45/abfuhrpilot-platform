{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5434;Database=abfuhrpilot;Username=abfuhrpilot;Password=abfuhrpilot"
  },
  "Database": {
    "UseInMemory": false
  },
  "Jwt": {
    "Issuer": "AbfuhrPilot",
    "Audience": "AbfuhrPilot",
    "SecretKey": "",
    "AccessTokenMinutes": 60
  },
  "Auth": {
    "PasswordResetHours": 2,
    "EmailVerificationHours": 48,
    "ExposeTokensForDev": false
  },
  "Storage": {
    "PhotoPath": ""
  },
  "Routing": {
    "Provider": "GraphHopper",
    "GraphHopper": {
      "ApiKey": "",
      "BaseUrl": "https://graphhopper.com/api/1",
      "TimeoutSeconds": 15,
      "Profile": "car"
    },
    "FallbackProvider": "None"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "RateLimiting": {
    "AuthLogin": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AuthAccountWrite": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "AuthTokenConfirm": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AuthSession": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Seed": {
    "Enabled": true
  },
  "Swagger": {
    "Enabled": true
  }
}
