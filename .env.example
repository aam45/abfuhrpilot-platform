# ---- AbfuhrPilot environment example ----
# Copy to .env and adjust. NEVER commit real secrets.

# PostgreSQL connection used by the API (ConnectionStrings__Default)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=abfuhrpilot;Username=abfuhrpilot;Password=abfuhrpilot

# JWT signing (must be >= 32 chars). Generate a strong random value in production.
Jwt__SecretKey=change-me-to-a-long-random-secret-at-least-32-characters
Jwt__Issuer=AbfuhrPilot
Jwt__Audience=AbfuhrPilot
Jwt__AccessTokenMinutes=60

# Routing / optimization provider. Leave the API key empty to use the local
# fallback (keeps stop order, straight-line estimate) — the app still works.
Routing__Provider=GraphHopper
Routing__GraphHopper__ApiKey=
Routing__GraphHopper__BaseUrl=https://graphhopper.com/api/1
# Routing profile: car (default) | truck | small_truck | custom.
# Truck restrictions are only claimed as active with a truck-capable profile.
Routing__GraphHopper__Profile=car

# Password-reset / email-verification token exposure for local dev/testing only.
Auth__ExposeTokensForDev=false

# Local folder for uploaded problem photos (blank = App_Data/problem-photos).
Storage__PhotoPath=

# Use the in-memory database instead of PostgreSQL (great for demos/CI). true|false
Database__UseInMemory=false

# Seed demo data on startup. true|false
Seed__Enabled=true

# Allowed frontend origins (CORS), comma separated is not supported here — edit appsettings.
# Cors__Origins__0=http://localhost:4200
